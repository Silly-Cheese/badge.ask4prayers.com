rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function accessRecord(nameHash) {
      return get(/databases/$(database)/documents/accessDirectory/$(nameHash));
    }

    match /system/bootstrap {
      allow get: if isAdmin();

      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/system/bootstrap)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.setupCodeHash == "be03b9d3bd03a138cb3435a0fbfac040d53c7021508e002f1eb8c36cee38941e";

      allow update: if isAdmin();
      allow delete: if false;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == uid
        && (
          request.resource.data.role == "holder"
          ||
          (
            request.resource.data.role == "admin"
            && !exists(/databases/$(database)/documents/system/bootstrap)
            && request.resource.data.setupCodeHash == "be03b9d3bd03a138cb3435a0fbfac040d53c7021508e002f1eb8c36cee38941e"
          )
        );

      allow update: if isAdmin();
      allow delete: if false;
    }

    match /badges/{badgeId} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /publicCredentials/{credentialToken} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /accessDirectory/{nameHash} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin();

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.claimed == false
          && request.auth.token.email == resource.data.authEmail
          && request.resource.data.claimed == true
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "claimed",
            "ownerUid",
            "claimedAt"
          ])
        );

      allow delete: if false;
    }

    match /badgeOwners/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == uid
        && accessRecord(request.resource.data.nameHash).data.claimed == false
        && request.auth.token.email == accessRecord(request.resource.data.nameHash).data.authEmail
        && request.resource.data.badgeId == accessRecord(request.resource.data.nameHash).data.badgeId
        && request.resource.data.credentialToken == accessRecord(request.resource.data.nameHash).data.credentialToken;

      allow update: if isAdmin();
      allow delete: if false;
    }

    match /scanLogs/{scanId} {
      allow get, list: if isAdmin();

      // Public and internal badge verification may append an audit record.
      // Keep this rule deliberately simple so it is accepted by the
      // Firestore rules compiler while scan records remain immutable.
      allow create: if request.resource.data.result != null
        && request.resource.data.source != null
        && request.resource.data.purpose != null
        && request.resource.data.scannedAt == request.time;

      allow update: if false;
      allow delete: if false;
    }
  }
}
